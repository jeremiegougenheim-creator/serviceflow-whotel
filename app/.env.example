# ── Supabase (project "serviceflow", Singapore) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon JWT; safe in the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: used by the engine (scheduled jobs), invitations and the seed. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for the scheduled jobs (pg_cron / Vercel cron call /api/jobs/* with it)
JOBS_SECRET=change-me

# ── Optional integrations ───────────────────────────────────────────────────
# Email for the 18:00 brief and the debrief (resend.com). Leave empty to keep in-app only.
RESEND_API_KEY=
EMAIL_FROM="ServiceFlow <brief@service-flow.app>"
# Web push (generate once: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@service-flow.app
# Server-side speech to text fallback for browsers without the Web Speech API (OpenAI Whisper)
OPENAI_API_KEY=

# ── Seed (demo accounts) ─────────────────────────────────────────────────────
SEED_DEMO_PASSWORD=serviceflow-demo
